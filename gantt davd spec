    {
      "name": "input",
      "source": "dataset",
      "transform": [
        {
          "type": "formula",
          "as": "start",
          "expr": "+datetime(year(datum.start),month(datum.start),date(datum.start),hours(datum.start),minutes(datum.start))"
        },
        {
          "type": "formula",
          "as": "end",
          "expr": "+datetime(year(datum.end),month(datum.end),date(datum.end),hours(datum.end),minutes(datum.end))"
        },
        {"type": "formula", "as": "labelEnd", "expr": "datum.end"},
        {"type": "formula", "as": "end", "expr": "datetime(+datum.end+oneDay)"},
        {
          "type": "formula",
          "as": "days",
          "expr": "round(((datum.end-datum.start)/oneDay)*10)/10"
        },
        {
          "type": "formula",
          "as": "completionLabel",
          "expr": "datum.completion+'%'"
        },
        {
          "type": "formula",
          "as": "level",
          "expr": "'task'"
        },
        {
          "type": "formula",
          "as": "levelRank",
          "expr": "3"
        },
        {
          "type": "joinaggregate",
          "fields": ["start"],
          "ops": ["min"],
          "as": ["projectStart"],
          "groupby": ["project"]
        },
        {
          "type": "joinaggregate",
          "fields": ["start"],
          "ops": ["min"],
          "as": ["phaseStart"],
          "groupby": ["project", "phase"]
        },
        {
          "type": "window",
          "sort": {"field": "start", "order": "ascending"},
          "ops": ["rank"],
          "as": ["taskSort"],
          "groupby": ["project", "phase"]
        },
        {"type": "formula", "as": "start", "expr": "+datum.start"},
        {"type": "formula", "as": "end", "expr": "+datum.end"}
      ]
    },
    {
      "name": "projects",
      "source": "input",
      "transform": [
        {
          "type": "aggregate",
          "fields": ["start", "end", "completion", "task", "completion", "labelEnd", "projectStart", "phase"],
          "ops": ["min", "max", "sum", "count", "mean", "max", "min", "min"],
          "as": ["start", "end", "sum", "count", "completion", "labelEnd", "projectStart", "phaseForColor"],
          "groupby": ["project"]
        },
        {"type": "formula", "as": "task", "expr": "datum.project"},
        {"type": "formula", "as": "phase", "expr": "datum.phaseForColor"},
        {"type": "formula", "as": "level", "expr": "'project'"},
        {"type": "formula", "as": "levelRank", "expr": "1"},
        {"type": "formula", "as": "phaseStart", "expr": "datum.projectStart"},
        {"type": "formula", "as": "completion", "expr": "round(datum.completion)"},
        {"type": "formula", "as": "days", "expr": "round(((datum.end-datum.start)/oneDay)*10)/10"},
        {"type": "formula", "as": "id", "expr": "'proj_' + datum.project"}
